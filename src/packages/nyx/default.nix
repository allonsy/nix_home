{
  pkgs,
  lib,
  fonts,
  hyprland,
  graphics,
  init,
  jujutsu,
  kernel,
  kitty,
  linker,
  locale,
  nix,
  nvim,
  ssh,
  sudo,
  polkit,
  profileManager,
  scripts,
  setup,
  zed,
  zsh,
  ...
}:
let
  allPkgs = with pkgs; [
    alsa-utils
    bash
    bat
    cacert
    coreutils
    devenv
    dhcpcd
    dbus
    eza
    fonts
    gcr_3 # prompt for gnome-keyring
    git
    gnome-keyring
    google-chrome
    graphics
    hyprland
    init
    jujutsu
    kernel
    kitty
    kmod
    libcap.lib
    libvdpau-va-gl
    linker
    locale
    nix
    nixd
    nvim
    openssh
    openssl.out
    pam
    polkit
    profileManager
    rofi
    rustup
    scripts
    seatd
    (lib.hiPrio setup)
    ssh
    steam
    strace
    systemd
    sudo
    tmux
    uv
    wpa_supplicant
    xdg-utils
    zed
    zoom-us
    zsh
  ];
in
pkgs.buildEnv {
  name = "nyx";
  paths = allPkgs;
}
