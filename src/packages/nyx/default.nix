{
  pkgs,
  lib,
  fonts,
  hyprland,
  init,
  jujutsu,
  kernel,
  kitty,
  locale,
  nix,
  nvim,
  ssh,
  sudo,
  polkit,
  profileManager,
  scripts,
  setup,
  zed,
  zsh,
  ...
}:
let
  allPkgs = with pkgs; [
    alsa-utils
    bash
    bat
    coreutils
    dhcpcd
    dbus
    eza
    fonts
    gcr_3 # prompt for gnome-keyring
    git
    gnome-keyring
    google-chrome
    hyprland
    init
    jujutsu
    kernel
    kitty
    kmod
    locale
    nix
    nixd
    nvim
    openssh
    pam
    polkit
    profileManager
    rofi
    rustup
    scripts
    seatd
    (lib.hiPrio setup)
    ssh
    strace
    systemd
    sudo
    tmux
    uv
    wpa_supplicant
    xdg-utils
    zed
    zsh
  ];
in
pkgs.buildEnv {
  name = "nyx";
  paths = allPkgs;
}
