import json
import os
import subprocess
import sys


def get_latest_sha(repo_config) -> str | None:
    repo_url = repo_config["repo"]
    if "ref" in repo_config:
        branch = repo_config["ref"]
    else:
        branch = "HEAD"
    result = subprocess.run(
        ["git", "ls-remote", repo_url, branch], capture_output=True, text=True
    )
    output = result.stdout.strip()
    if result.returncode != 0 or len(output) == 0:
        print(f"Failed to get latest SHA for {repo_url}", file=sys.stderr)
        return None
    latest_sha = output.split()[0]
    return latest_sha


def process_json_file(file_path):
    with open(file_path, "r") as f:
        repo_configs = json.load(f)

    for repo_config in repo_configs:
        sha = get_latest_sha(repo_config)
        if sha:
            if sha != repo_config["commit"]:
                print(
                    f"Updating {repo_config['name']}: {repo_config['commit']} => {sha}"
                )
                repo_config["commit"] = sha
            else:
                print(f"{repo_config['name']} is already up to date")

    with open(file_path, "w") as f:
        json.dump(repo_configs, f, indent=2)


if __name__ == "__main__":
    os.chdir(os.path.dirname(__file__))
    print("Updating Grammars...")
    process_json_file("languages/languages.json")
    print("")
    print("Updating Plugins...")
    process_json_file("plugins/plugins.json")
